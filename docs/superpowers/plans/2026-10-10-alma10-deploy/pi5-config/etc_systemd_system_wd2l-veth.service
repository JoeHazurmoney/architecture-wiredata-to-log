[Unit]
Description=wd2l single-box demo: veth pair standing in for the network tap and one-strand fiber
DefaultDependencies=no
After=systemd-udevd.service
Before=network-pre.target wd2l-egress-nic.service wd2l-capture-nic.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c "ip link show wd2l-tx >/dev/null 2>&1 || ip link add wd2l-tx type veth peer name wd2l-cap"

[Install]
RequiredBy=wd2l-egress-nic.service wd2l-capture-nic.service
