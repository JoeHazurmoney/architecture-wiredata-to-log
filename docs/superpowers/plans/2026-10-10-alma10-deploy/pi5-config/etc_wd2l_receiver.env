# wd2l-receiver options. wd2l-receiver.service and wd2l-receiver.container both read this file;
# change options here, not in the units. One option per line: systemd joins lines ending in a
# backslash. All options: python3 -m wd2l.receiver --help, and docs/deployment/receiver.md.
# Installed as /etc/wd2l/receiver.env (the RPM keeps your edits on upgrade).
WD2L_RECEIVER_ARGS="--live wd2l-cap \
--dst-ip 10.255.255.2 \
--dst-port 5514 \
--src-ip 10.255.255.1 \
--src-port 5514 \
--state /var/lib/wd2l/state.json \
--spool-dir /var/lib/wd2l/spool \
--hec-url https://192.168.1.27:8088 \
--hec-token-file /etc/wd2l/hec.token \
--hec-ca /etc/wd2l/siem-ca.pem \
--default-index enclave1 \
--health-index wd2l \
--hec-audit-token-file /etc/wd2l/hec-audit.token \
--audit-index wd2l_audit \
--audit-dir /var/log/wd2l \
--pcap-dir /var/lib/wd2l/pcap \
--chrony-addr 127.0.0.1:323 \
--log-format json"
