[Unit]
Description=wd2l receiver: rebuild logs from the tapped stream and send them to the SIEM
After=wd2l-capture-nic.service network-online.target
Requires=wd2l-capture-nic.service
Wants=network-online.target

[Service]
User=wd2l
Group=wd2l
Environment=PYTHONPATH=/opt/wd2l
ExecStart=/usr/bin/python3 -m wd2l.receiver \
    --live ens256 \
    --dst-ip 10.255.255.2 --dst-port 5514 --src-ip 10.255.255.1 --src-port 5514 \
    --state /var/lib/wd2l/state.json \
    --spool-dir /var/lib/wd2l/spool \
    --hec-url https://siem.enclave2.example:8088 \
    --hec-token-file /etc/wd2l/hec.token \
    --hec-ca /etc/wd2l/siem-ca.pem \
    --default-index enclave1 \
    --health-index wd2l \
    --hec-audit-token-file /etc/wd2l/hec-audit.token \
    --audit-index wd2l_audit \
    --audit-dir /var/log/wd2l \
    --pcap-dir /var/lib/wd2l/pcap \
    --log-format json
Restart=always
RestartSec=2
# On stop: final health record, up to 15 s for queued events to reach the SIEM (the rest go
# to the spool), then the state file is saved.
TimeoutStopSec=60

# Raw socket for capture, nothing else.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wd2l /var/log/wd2l
# Audit records (docs/audit-and-health-plan.md section 10). The install step creates
# /var/log/wd2l (owner wd2l, group wd2l-audit, mode 2750); wd2l-audit-seal.timer makes the files
# append-only and keeps them a year.
UMask=0027
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_PACKET AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
