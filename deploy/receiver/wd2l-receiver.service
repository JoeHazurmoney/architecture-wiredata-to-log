[Unit]
Description=wd2l receiver: rebuild logs from the tapped stream and send them to the SIEM
# Wait for the clock (chrony-wait, at most about 3 minutes), so the first time stamps and the
# first time check aren't from an unsynced clock. The capture (tcpdump) doesn't wait.
After=wd2l-capture-nic.service network-online.target time-sync.target
Requires=wd2l-capture-nic.service
Wants=network-online.target time-sync.target chrony-wait.service

[Service]
User=wd2l
Group=wd2l
Environment=PYTHONPATH=/opt/wd2l
# Site options (capture NIC, flow, SIEM, tokens, paths): /etc/wd2l/receiver.env.
EnvironmentFile=/etc/wd2l/receiver.env
ExecStart=/usr/bin/python3 -m wd2l.receiver $WD2L_RECEIVER_ARGS
Restart=always
RestartSec=2
# On stop: final health record, up to 15 s for queued events to reach the SIEM (the rest go
# to the spool), then the state file is saved.
TimeoutStopSec=60

# Raw socket for capture, nothing else.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wd2l /var/log/wd2l
# Audit records (docs/audit-and-health.md section 8). The install step creates
# /var/log/wd2l (owner wd2l, group wd2l-audit, mode 2750); wd2l-audit-seal.timer makes the files
# append-only and keeps them a year.
UMask=0027
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_PACKET AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
