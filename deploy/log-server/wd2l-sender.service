[Unit]
Description=wd2l sender: log aggregator JSON lines in, one-way UDP frames out
After=network-online.target wd2l-egress-nic.service
Wants=network-online.target
Requires=wd2l-egress-nic.service

[Service]
User=wd2l
Group=wd2l
Environment=PYTHONPATH=/opt/wd2l
ExecStart=/usr/bin/python3 -m wd2l.sender \
    --listen 127.0.0.1:10070 \
    --bind 10.255.255.1:5514 \
    --dst 10.255.255.2:5514 \
    --max-datagram 1472 \
    --auth-token-file /etc/wd2l/aggregator.token \
    --state /var/lib/wd2l/sender.json \
    --audit-dir /var/log/wd2l \
    --egress-iface ens224 \
    --log-format json
# Restart count + previous stream, so the receiver can link runs (see docs/wire-format.md).
StateDirectory=wd2l
# Audit records (docs/audit-and-health-plan.md section 10). The install step creates
# /var/log/wd2l (owner wd2l, group wd2l-audit, mode 2750); wd2l-audit-seal.timer makes the files
# append-only and keeps them a year.
ReadWritePaths=/var/log/wd2l
UMask=0027
# On SIGTERM the sender stops accepting, reads what is already arriving (--drain-timeout,
# 2 s), then sends the final heartbeat (marks the stream as cleanly ended).
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
